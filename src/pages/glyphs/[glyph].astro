---
import { getCollection, render } from 'astro:content'
import Layout from '../../layouts/Layout.astro'
import { generateGlyphSvg } from '../../utils/generateGlyphSvg'

export async function getStaticPaths() {
    const glyphs = await getCollection('glyphs')
    return glyphs.map((glyph) => ({
        params: { glyph: glyph.data.unicodeDecimal },
        props: { glyph },
    }))
}

const { glyph } = Astro.props
const { Content } = await render(glyph)

const upperSvg = await generateGlyphSvg(glyph.data.upperCase, glyph.data.script)
const showLower = glyph.data.lowerCase !== glyph.data.upperCase
const lowerSvg = showLower ? await generateGlyphSvg(glyph.data.lowerCase, glyph.data.script) : null
---

<Layout title={glyph.data.title}>
    <ul>
        <li>Unicode: {glyph.data.unicode}</li>
        <li>Unicode Decimal: {glyph.data.unicodeDecimal}</li>
        <li>Script: {glyph.data.script}</li>
        {
            glyph.data.numericalValue !== undefined && (
                <li>Numerical Value: {glyph.data.numericalValue}</li>
            )
        }
    </ul>
    <Content />

    <div class="not-prose mt-6 flex flex-wrap gap-8">
        <button
            class="copy-btn group relative flex h-[120px] cursor-copy items-end dark:invert"
            data-char={glyph.data.upperCase}
            title="Copy"
            aria-label="Copy uppercase glyph"
            x-data="{
                copied: false,
                copy() {
                    navigator.clipboard.writeText(this.$el.dataset.char)
                    this.copied = true
                    setTimeout(() => { this.copied = false }, 1500)
                },
            }"
            x-on:click="copy()"
        >
            <Fragment set:html={upperSvg} />
            <span
                x-show="copied"
                x-transition.opacity
                class="pointer-events-none absolute inset-x-0 -top-8 flex justify-center"
            >
                <span
                    class="rounded bg-stone-800 px-2 py-1 text-xs text-white dark:bg-stone-100 dark:text-stone-900"
                >
                    Copied!
                </span>
            </span>
        </button>
        {
            showLower && lowerSvg && (
                <button
                    class="copy-btn group relative flex h-[120px] cursor-copy items-end dark:invert"
                    data-char={glyph.data.lowerCase}
                    title="Copy"
                    aria-label="Copy lowercase glyph"
                    x-data="{
                        copied: false,
                        copy() {
                            navigator.clipboard.writeText(this.$el.dataset.char)
                            this.copied = true
                            setTimeout(() => { this.copied = false }, 1500)
                        },
                    }"
                    x-on:click="copy()"
                >
                    <Fragment set:html={lowerSvg} />
                    <span
                        x-show="copied"
                        x-transition.opacity
                        class="pointer-events-none absolute inset-x-0 -top-8 flex justify-center"
                    >
                        <span class="rounded bg-stone-800 px-2 py-1 text-xs text-white dark:bg-stone-100 dark:text-stone-900">
                            Copied!
                        </span>
                    </span>
                </button>
            )
        }
    </div>
</Layout>
